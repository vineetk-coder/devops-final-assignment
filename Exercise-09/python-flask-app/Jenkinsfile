// Exercise-09 — Jenkins multi-stage pipeline (Build -> Test -> Deploy -> Run -> Test App)
//
// APP_DIR is the app folder RELATIVE to the repo root:
//   - repo = this whole project        -> 'Exercise-09/python-flask-app' (default)
//   - repo = only python-flask-app     -> '.'
pipeline {
    agent any

    parameters {
        string(name: 'APP_DIR', defaultValue: 'Exercise-09/python-flask-app',
               description: 'Application folder relative to the workspace')
    }

    environment {
        APP_PATH   = "${WORKSPACE}/${params.APP_DIR}"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                dir("${params.APP_DIR}") {
                    sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    '''
                }
            }
        }
        stage('Code Quality') {
            // "Additional Enhancements" from the reference: flake8
            steps {
                echo 'Running code quality checks...'
                dir("${params.APP_DIR}") {
                    sh '''
                    . venv/bin/activate
                    pip install flake8
                    flake8 . --exclude=venv --max-line-length=120
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                dir("${params.APP_DIR}") {
                    sh '. venv/bin/activate && python3 -m unittest discover -s .'
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                mkdir -p ${DEPLOY_DIR}
                cp ${APP_PATH}/app.py ${DEPLOY_DIR}/
                '''
            }
        }
        stage('Run Application') {
            steps {
                echo 'Running application...'
                // JENKINS_NODE_COOKIE stops Jenkins from killing the background app when the step ends
                sh '''
                [ -f ${DEPLOY_DIR}/app.pid ] && kill $(cat ${DEPLOY_DIR}/app.pid) 2>/dev/null || true
                JENKINS_NODE_COOKIE=dontKillMe nohup ${APP_PATH}/venv/bin/python3 ${DEPLOY_DIR}/app.py > ${DEPLOY_DIR}/app.log 2>&1 &
                echo $! > ${DEPLOY_DIR}/app.pid
                '''
            }
        }
        stage('Test Application') {
            steps {
                echo 'Testing application...'
                dir("${params.APP_DIR}") {
                    sh '. venv/bin/activate && python3 test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
